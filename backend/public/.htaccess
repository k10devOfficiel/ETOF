# Apache Server Configuration - ETOF SARL Backend

# Interdiction d'accès aux fichiers et répertoires sensibles
<FilesMatch "(^\.|\.(env|env\.example|sql|log|md|json|lock|xml|yml|yaml|bak|config|dist|map)$)">
    Require all denied
</FilesMatch>

Options -Indexes -MultiViews

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self';"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Forcer HTTPS en environnement de production
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{ENV:APP_ENV} production
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Empêcher l'accès direct aux dossiers et fichiers sensibles
    RewriteRule ^(\.git|\.env|database|storage|src|vendor|tests|composer\.(json|lock)|package(-lock)?\.json) - [F,L,NC]

    # Rediriger toutes les requêtes d'API vers index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

