{
    "name": "etof/backend",
    "description": "Backend API REST pour le site internet ETOF SARL",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "phpmailer/phpmailer": "^6.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    }
}
